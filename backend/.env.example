# Copy this file to .env and fill in real values. .env is git-ignored.

# --- Security (generate each with: python -c "import secrets; print(secrets.token_hex(32))") ---
HMAC_SECRET_KEY=generate_a_64_char_hex_key_here
JWT_SECRET=generate_a_64_char_hex_key_here

# --- Google reCAPTCHA (server-side secret; the matching site key lives in frontend/.env) ---
# For local demos you can use Google's published test keys from
# https://developers.google.com/recaptcha/docs/faq
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# --- Optional services (the pipeline falls back to SQLite / NetworkX / in-memory without them) ---
REDIS_HOST=localhost
REDIS_PORT=6379

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=your_neo4j_password

POSTGIS_HOST=localhost
POSTGIS_PORT=5432
POSTGIS_DB=cybercrime_gis
POSTGIS_USER=postgres
POSTGIS_PASS=your_postgis_password

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
